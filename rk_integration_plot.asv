function rk_integration_plot

    orbit_params = struct();
    orbit_params.m_sun = 1;
    orbit_params.m_planet = 1;
    orbit_params.G = 40;
    x0 = 8;
    y0 = 0;
    dxdt0 = 0;
    dydt0 = 1;
    V0 = [x0;y0;dxdt0;dydt0];
    
    tspan = [0 30];
    h = 0.01;

    t_range = linspace(tspan(1), tspan(2), 100);
    V = compute_planetary_motion(t_range, V0, orbit_params);
    rate_func = @(t,V) gravity_rate_func(t,V,orbit_params);

    % Kutta's third-order method
    BT_third.A = [0, 0, 0; 1/2, 0, 0; -1, 2, 0];
    BT_third.B = [1/6; 2/3; 1/6];
    BT_third.C = [0; 1/2; 1];

    %Heun's method
    BT_heun.A = [0, 0; 1, 0];
    BT_heun.B = [1/2; 1/2];
    BT_heun.C = [0; 1];

    %3/8 forth
    BT_threeeight.A = [0, 0, 0, 0; 1/3, 0, 0, 0; -1/3, 1, 0, 0; 1, -1, 1, 0];
    BT_threeeight.B = [1/8; 3/8; 3/8; 1/8];
    BT_threeeight.C = [0; 1/3; 2/3; 1];

    [t_heun, X_heun] = explicit_RK_fixed_step_integration(rate_func, tspan, V0, h, BT_heun);
    [t_third, X_third] = explicit_RK_fixed_step_integration(rate_func, tspan, V0, h, BT_third);
    [t_threeeight, X_threeeight] = explicit_RK_fixed_step_integration(rate_func, tspan, V0, h, BT_threeeight);
    
    

    %Plot - both x and y 
    figure();
    axis equal; axis square;
    axis([-20,20,-20,20])
    hold on

    plot(0,0,'ro','markerfacecolor','r','markersize',5);
    plot(V(:,1), V(:,2), 'k', 'LineWidth', 2);

    plot(X_heun(:,1), X_heun(:,2), '--', 'LineWidth', 1.5);
    plot(X_third(:,1), X_third(:,2), '-.', 'LineWidth', 1.5);
    plot(X_threeeight(:,1), X_threeeight(:,2), ':', 'LineWidth', 1.5);
    

    xlabel('$x$ position', 'Interpreter', 'Latex');
    ylabel('$y$ position', 'Interpreter', 'Latex');
    title('Planetary Motion Plot', 'Interpreter', 'Latex', 'FontSize', 22)

    legend('Sun', 'Exact solution', "Heun's Second Order", "Kutta's Third-Order", "3/8-Rule Fourth-Order", 'Location', 'best', 'Interpreter', 'Latex');
    hold off;

   

    % Plot subfigures
    figure();
    
    subplot(2,1,1);
    plot(t_range, V(:,1), 'k-', 'LineWidth', 2);
    hold on;
    plot(t_heun, X_heun(:,1), '--', 'LineWidth', 1.5);
    plot(t_third, X_third(:,1), '-.', 'LineWidth', 1.5);
    plot(t_threeeight, X_threeeight(:,1), ':', 'LineWidth', 1.5);
   

    xlabel('Time', 'Interpreter', 'latex', 'FontSize', 14);
    ylabel('$x(t)$', 'Interpreter', 'latex', 'FontSize', 14);
    title('Planetary Motion x-component', 'Interpreter','latex', 'FontSize',16);
    legend('Exact solution', "Heun's Second Order", "Kutta's Third-Order", "3/8-Rule Fourth-Order", 'Location', 'southeast', 'Interpreter', 'latex', 'FontSize', 12);

    subplot(2,1,2);
    plot(t_range, V(:,2), 'k-', 'LineWidth', 2);
    hold on;
    plot(t_heun, X_heun(:,2), '--', 'LineWidth', 1.5);
    plot(t_third, X_third(:,2), '-.', 'LineWidth', 1.5);
    plot(t_threeeight, X_threeeight(:,2), ':', 'LineWidth', 1.5);
    

   
    xlabel('Time', 'Interpreter', 'latex', 'FontSize',14);
    ylabel('$y(t)$', 'Interpreter', 'latex', 'FontSize',14);
    title('Planetary Motion y-component', 'Interpreter', 'Latex', 'FontSize', 16);
    legend('Exact solution', "Heun's Second Order", "Kutta's Third-Order", "3/8-Rule Fourth-Order", 'Location', 'southwest', 'Interpreter', 'latex', 'Fo');

     sgtitle('Integration of a Planetary System via Several Runge-Kutta Methods', 'Interpreter', 'latex', 'FontSize', 18);

end